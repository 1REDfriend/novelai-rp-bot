# --- Required ---
DISCORD_TOKEN=your-discord_token
NOVELAI_TOKEN=your-novelai_token

# Optional: register slash commands to one server for instant updates.
# Leave empty to register globally (can take up to an hour to appear).
DISCORD_GUILD_ID=your-discord_guild_id

# --- Text generation ---
NOVELAI_TEXT_URL=your-novelai_text_url
NOVELAI_TEXT_MODEL=your-novelai_text_model
# Max tokens the bot generates per reply.
MAX_OUTPUT_TOKENS=your-max_output_tokens
# Total prompt + output budget. Older chat history is dropped first when exceeded.
MAX_CONTEXT_TOKENS=your-max_context_tokens
TEMPERATURE=your-temperature
TOP_P=your-top_p

# --- /chat assistant mode ---
NOVELAI_CHAT_URL=your-novelai_chat_url
# Max tokens per reply in /chat channels (longer than roleplay replies).
CHAT_MAX_OUTPUT_TOKENS=your-chat_max_output_tokens

# --- /builder character builder ---
# Max tokens per reply; a full character file needs about 2000.
BUILDER_MAX_OUTPUT_TOKENS=your-builder_max_output_tokens
# Context budget for builder chats (the edited file plus the conversation).
BUILDER_MAX_CONTEXT_TOKENS=your-builder_max_context_tokens

# --- Context building ---
# How many recent messages are scanned for lorebook keys.
LOREBOOK_SCAN_DEPTH=your-lorebook_scan_depth
# The Author's Note is inserted this many messages before the end of the history.
AUTHORS_NOTE_DEPTH=your-authors_note_depth
# Story rules added after every roleplay Author's Note ({{char}} = character name). "off" turns them off.
STORY_DIRECTIVE=your-story_directive

# --- Paths ---
CHARACTERS_DIR=your-characters_dir
DATABASE_PATH=your-database_path
